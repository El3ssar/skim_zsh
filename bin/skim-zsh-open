#!/usr/bin/env bash
#
# skim-zsh-open — open a file full screen from inside skim (Ctrl+O).
#
#   pdf    -> meowpdf (kitty only), else mcat
#   image  -> mcat, interactive viewer
#   other  -> $EDITOR (default: nvim, then vi)

file=$1
[ -f "$file" ] || exit 0

shopt -s nocasematch
case $file in
  *.pdf)
    command -v meowpdf >/dev/null 2>&1 && [ "$TERM" = xterm-kitty ] && exec meowpdf "$file"
    command -v mcat >/dev/null 2>&1 && exec mcat -I -- "$file"
    ;;
  *.png|*.jpg|*.jpeg|*.gif|*.webp|*.bmp|*.tif|*.tiff|*.svg|*.ico|*.avif|*.heic)
    command -v mcat >/dev/null 2>&1 && exec mcat -I -- "$file"
    ;;
esac

editor=${VISUAL:-${EDITOR:-}}
[ -n "$editor" ] || { command -v nvim >/dev/null 2>&1 && editor=nvim || editor=vi; }
exec $editor "$file"
